{
  "name": "geoglyph-locate-2026",
  "version": "1.0.0",
  "private": true,
  "description": "GeoGlyph Locate 2026 conference edition with public Survey123 results",
  "scripts": {
    "dev": "node scripts/build.cjs && node scripts/dev-server.cjs",
